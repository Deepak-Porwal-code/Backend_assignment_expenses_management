# ---------------------------------------------------------------------------
# Moneta API — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/moneta?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/moneta

# Use a long random string (at least 32 characters) in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no wildcards).
# Local Vite + deployed frontend, e.g.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://your-frontend.vercel.app

# Optional: cookie name
COOKIE_NAME=moneta_token
